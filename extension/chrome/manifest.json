{
  "manifest_version": 3,
  "name": "Remote Music Control",
  "version": "1.0.0",
  "description": "Lets the Remote Music Control server on this PC search YouTube Music and manage its queue.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ]
}
